---
import type { Content } from '../i18n';
import Icon from './Icon.astro';
import SystemsIllustration from './SystemsIllustration.astro';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const a = t.approach;
---

<section id="approach" class="section border-y border-line bg-white" aria-labelledby="approach-heading">
  <div class="container-site grid gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <p class="eyebrow" data-reveal>{a.eyebrow}</p>
      <h2 id="approach-heading" class="h-section mt-5" data-reveal>{a.heading}</h2>
      <p class="lead mt-6" data-reveal>{a.lead}</p>
      <div class="mx-auto mt-10 max-w-xs sm:max-w-sm lg:mx-0" data-reveal>
        <SystemsIllustration label={a.illustrationLabel} class="w-full" />
      </div>
    </div>

    <div class="lg:col-span-7">
      <ol class="divide-y divide-line border-y border-line">
        {
          a.points.map((p, i) => (
            <li class="grid gap-2 py-7 sm:grid-cols-[4.5rem_1fr]" data-reveal>
              <span class="font-serif text-3xl text-sage" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-[1.65rem] leading-tight">{p.title}</h3>
                <p class="mt-2 text-muted">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="mt-12 rounded-2xl bg-forest p-7 text-ivory sm:p-9" data-reveal>
        <h3 class="flex items-center gap-3 font-sans text-[0.78rem] font-semibold tracking-[0.18em] text-mint uppercase">
          <Icon name="shield" size={20} />
          {a.principlesTitle}
        </h3>
        <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {
            a.principles.map((p) => (
              <li class="flex gap-3 text-[0.95rem] leading-snug text-ivory/90">
                <Icon name="check" size={18} class="mt-0.5 shrink-0 text-mint" />
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

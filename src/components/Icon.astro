---
import type { IconName } from '../i18n/types';

interface Props {
  name: IconName | 'arrow' | 'plus' | 'menu' | 'close' | 'check' | 'alert' | 'arrow-up';
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 24 } = Astro.props;

// Spójny zestaw ikon liniowych: siatka 24×24, kreska 1.5, zaokrąglone zakończenia.
const paths: Record<Props['name'], string> = {
  consult:

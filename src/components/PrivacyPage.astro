---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FEATURES } from '../config';
import { ROUTES, getContent, type Lang } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const t = getContent(Astro.props.lang);
const p = t.privacy;
---

<BaseLayout t={t} page="privacy" title={p.title} description={p.description}>
  <article class="container-site max-w-3xl pt-36 pb-24 sm:pt-40">
    <a href={ROUTES.home[t.lang]} class="inline-flex items-center gap-2 text-[0.9rem] font-semibold text-sage-ink hover:text-forest">
      <Icon name="arrow" size={16} class="rotate-180" />
      {p.back}
    </a>
    <h1 class="mt-8 text-[2.6rem] leading-tight break-words hyphens-auto sm:text-6xl">{p.heading}</h1>
    <p class="mt-4 text-[0.9rem] text-muted">{p.updated}</p>

    {
      !FEATURES.privacyPolicyReviewed && (
        <p class="mt-8 flex gap-3 rounded-xl border border-[#e4d6c4] bg-sand/60 p-5 text-[0.93rem] text-graphite">
          <Icon name="alert" size={20} class="mt-0.5 shrink-0 text-[#8a5a2b]" />
          {p.draftNotice}
        </p>
      )
    }

    <div class="mt-12 space-y-10">
      {
        p.sections.map((s) => (
          <section>
            <h2 class="text-3xl">{s.title}</h2>
            <div class="mt-3 space-y-3 text-graphite/90">
              {s.paragraphs.map((para) => (
                <p>{para}</p>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </article>
</BaseLayout>

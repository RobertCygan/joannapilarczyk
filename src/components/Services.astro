---
import type { Content } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const s = t.services;
---

<section id="services" class="section" aria-labelledby="services-heading">
  <div class="container-site">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>{s.eyebrow}</p>
        <h2 id="services-heading" class="h-section mt-5" data-reveal>{s.heading}</h2>
      </div>
      <p class="lead lg:col-span-5" data-reveal>{s.intro}</p>
    </div>

    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        s.items.map((item, i) => (
          <li
            class="service-card card group flex flex-col p-7 transition duration-500 hover:-translate-y-1 hover:border-mint hover:shadow-lift"
            data-reveal
            style={`--reveal-delay: ${(i % 4) * 70}ms`}
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-mint-50 text-forest transition-colors duration-500 group-hover:bg-mint">
              <Icon name={item.icon} size={24} class="service-icon" />
            </span>
            <h3 class="mt-6 text-[1.6rem] leading-tight">{item.title}</h3>
            <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-muted">{item.text}</p>
            {item.note && (
              <p class="mt-5 border-t border-line pt-4 text-[0.84rem] leading-snug text-sage-ink">
                {item.note}
              </p>
            )}
          </li>
        ))
      }
    </ul>

    <div class="mt-20 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h3 class="text-3xl sm:text-4xl" data-reveal>{s.areasHeading}</h3>
        <p class="mt-4 text-muted" data-reveal>{s.areasIntro}</p>
      </div>
      <div class="lg:col-span-8" data-reveal>
        <details class="areas group rounded-2xl border border-line bg-white">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-2xl px-6 py-5 font-semibold text-forest transition-colors hover:bg-mint-50 sm:px-8">
            <span>{s.areasToggle}</span>
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line transition-transform duration-500 group-open:rotate-45">
              <Icon name="plus" size={18} />
            </span>
          </summary>
          <div class="grid gap-x-10 gap-y-8 border-t border-line px-6 py-8 sm:grid-cols-2 sm:px-8">
            {
              s.areas.map((area) => (
                <div>
                  <h4 class="font-serif text-xl font-semibold text-forest">{area.title}</h4>
                  <ul class="mt-3 space-y-1.5 text-[0.93rem] text-muted">
                    {area.items.map((item) => (
                      <li class="flex gap-2.5">
                        <span class="mt-[0.7em] h-1 w-1 shrink-0 rounded-full bg-sage" aria-hidden="true" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </details>
        <div class="mt-5 flex flex-wrap gap-2" aria-hidden="true">
          {
            s.areas.map((area) => (
              <span class="rounded-full border border-line bg-white px-3.5 py-1.5 text-[0.82rem] text-muted">{area.title}</span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .areas summary::-webkit-details-marker {
    display: none;
  }
  .service-card:hover .service-icon {
    animation: nudge 0.9s var(--ease-calm);
  }
  @keyframes nudge {
    40% {
      transform: translateY(-2px) rotate(-4deg);
    }
    100% {
      transform: none;
    }
  }
</style>

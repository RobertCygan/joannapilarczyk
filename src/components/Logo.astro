---
interface Props {
  tagline: string;
  href: string;
  variant?: 'dark' | 'light';
  class?: string;
}

const { tagline, href, variant = 'dark', class: className = '' } = Astro.props;
const light = variant === 'light';
---

<a href={href} class:list={['group inline-flex items-center gap-3', className]}>
  <svg viewBox="0 0 48 48" class="h-9 w-9 shrink-0 sm:h-10 sm:w-10 transition-transform duration-700 group-hover:rotate-[8deg]" aria-hidden="true">
    <g fill="none" stroke-linecap="round" stroke-width="2.4">
      <path d="M26.485 15.515A12 12 0 1 1 21.106 12.409" stroke={light ? '#FAF9F6' : '#29483E'}></path>
      <path d="M21.515 32.485A12 12 0 1 1 26.894 35.591" stroke={light ? '#A8D5C2' : '#789C8A'}></path>
    </g>
  </svg>
  <span class="flex flex-col leading-none">
    <span
      class:list={[
        'font-serif text-[1.08rem] font-semibold tracking-[0.1em] whitespace-nowrap uppercase sm:text-[1.3rem] sm:tracking-[0.12em]',
        light ? 'text-ivory' : 'text-forest',
      ]}>Joanna Pilarczyk</span
    >
    <span
      class:list={[
        'mt-1.5 text-[0.58rem] font-semibold tracking-[0.18em] whitespace-nowrap uppercase sm:text-[0.62rem] sm:tracking-[0.22em]',
        light ? 'text-mint' : 'text-sage-ink',
      ]}>{tagline}</span
    >
  </span>
</a>

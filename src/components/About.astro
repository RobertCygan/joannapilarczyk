---
import { Picture } from 'astro:assets';
import photo from '../assets/joanna-about.jpg';
import { FEATURES, SITE } from '../config';
import type { Content, TimelineItem } from '../i18n/types';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const a = t.about;
const q = t.qualifications;

const columns: { title: string; items: TimelineItem[] }[] = [
  { title: q.educationTitle, items: q.education },
  { title: q.experienceTitle, items: q.experience },
];
---

<section id="about" class="section border-t border-line bg-white" aria-labelledby="about-heading">
  <div class="container-site">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <p class="eyebrow" data-reveal>{a.eyebrow}</p>
          <h2 id="about-heading" class="h-section mt-5" data-reveal>{a.heading}</h2>
          <figure class="mt-10 max-w-[17rem] sm:max-w-sm" data-reveal>
            <Picture
              src={photo}
              alt={a.portraitAlt}
              widths={[360, 560, 760]}
              sizes="(min-width: 1024px) 24rem, 80vw"
              formats={['avif', 'webp']}
              loading="lazy"
              class="aspect-[4/5] w-full rounded-[1.5rem] object-cover"
            />
          </figure>
        </div>
      </div>

      <div class="lg:col-span-7 lg:pt-14">
        <div class="space-y-6 text-[1.06rem] leading-[1.8]">
          {
            a.paragraphs.map((p, i) => (
              <p class:list={[i === 0 && 'font-serif text-[1.55rem] leading-snug text-forest sm:text-[1.75rem]']} data-reveal>
                {p}
              </p>
            ))
          }
        </div>

        <!-- Kwalifikacje i doświadczenie -->
        <div class="mt-16 border-t border-line pt-12" aria-labelledby="qual-heading">
          <p class="eyebrow" data-reveal>{q.eyebrow}</p>
          <h3 id="qual-heading" class="mt-4 text-3xl sm:text-4xl" data-reveal>{q.heading}</h3>
          <p class="mt-3 text-muted" data-reveal>{q.intro}</p>

          <div class="mt-10 grid gap-12 md:grid-cols-2 md:gap-10">
            {
              columns.map((col) => (
                <div data-reveal>
                  <h4 class="text-[0.75rem] font-semibold tracking-[0.18em] text-sage-ink uppercase">{col.title}</h4>
                  <ol class="mt-5 space-y-6 border-l border-mint pl-6">
                    {col.items.map((item) => (
                      <li class="relative">
                        <span class="absolute top-2 -left-[1.86rem] h-2.5 w-2.5 rounded-full border-2 border-white bg-sage" aria-hidden="true" />
                        <p class="text-[0.78rem] font-semibold tracking-[0.08em] text-sage-ink uppercase">{item.period}</p>
                        <p class="mt-1 font-semibold leading-snug text-forest">{item.title}</p>
                        {item.detail && <p class="mt-1.5 text-[0.93rem] leading-relaxed text-muted">{item.detail}</p>}
                      </li>
                    ))}
                  </ol>
                </div>
              ))
            }
          </div>

          <dl class="mt-12 grid gap-6 rounded-2xl bg-mint-50 p-6 sm:grid-cols-2 sm:p-8" data-reveal>
            <div>
              <dt class="text-[0.78rem] font-semibold tracking-[0.08em] text-sage-ink uppercase">{q.registrationLabel}</dt>
              <dd class="mt-1 font-serif text-2xl text-forest">{SITE.hprNumber}</dd>
            </div>
            {
              FEATURES.showMemberships && (
                <div class="sm:col-span-2">
                  <dt class="text-[0.78rem] font-semibold tracking-[0.08em] text-sage-ink uppercase">{q.membershipsTitle}</dt>
                  <dd class="mt-2">
                    <ul class="space-y-1 text-[0.95rem]">
                      {q.memberships.map((m) => (
                        <li>{m}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )
            }
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>

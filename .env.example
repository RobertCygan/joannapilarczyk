# Adres, na który formularz kontaktowy wysyła wiadomości (POST, multipart/form-data).
# Działa z usługami zgodnymi z Formspree lub Web3Forms, np.:
#   Formspree:  https://formspree.io/f/TWOJ_ID
#   Web3Forms:  https://api.web3forms.com/submit
# Bez tej wartości formularz wyświetla informację, że nie jest aktywny,
# i kieruje do kontaktu e-mailowego (nie pokazuje fałszywego potwierdzenia).
PUBLIC_FORM_ENDPOINT=

# Tylko dla Web3Forms: klucz dostępowy (access key) przypisany do adresu e-mail.
# Dla Formspree zostaw puste.
PUBLIC_FORM_ACCESS_KEY=
